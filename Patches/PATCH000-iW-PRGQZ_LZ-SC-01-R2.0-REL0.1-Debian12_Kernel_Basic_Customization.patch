+	pinctrl_typec: typec1grp {
+		fsl,pins = <
+			MX8MP_IOMUXC_GPIO1_IO09__GPIO1_IO09   		0x1c4 /* Type C IRQ GPIO*/
+		>;
+	};
+
+	pinctrl_typec_mux: typec1muxgrp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SPDIF_EXT_CLK__GPIO5_IO05  	0x1c4 /* Type C selection GPIO*/
+		>;
+	};
+
+	pinctrl_uart2: uart2grp { /*UART2: DATA UART IOMUX Pin Configuration*/
+		fsl,pins = <
+			MX8MP_IOMUXC_UART2_RXD__UART2_DCE_RX	0x140
+			MX8MP_IOMUXC_UART2_TXD__UART2_DCE_TX	0x140
+			MX8MP_IOMUXC_SAI3_RXC__UART2_DCE_CTS	0x140
+			MX8MP_IOMUXC_SAI3_RXD__UART2_DCE_RTS	0x140
+		>;
+	};
+
+	pinctrl_csi0_rst: csi0_rst_grp { /* MIPI_CSI0: Camera Reset IOMUX Pin Configuration */
+		fsl,pins = <
+			MX8MP_IOMUXC_GPIO1_IO10__GPIO1_IO10      	0x10
+		>;
+	};
+
+	pinctrl_csi_mclk: csi_mclk_grp { /* MIPI_CSI0: Camera clock IOMUX Pin Configuration */
+		fsl,pins = <
+			MX8MP_IOMUXC_ECSPI2_MISO__CCM_CLKO1	0x50
+		>;
+	};
+
+	pinctrl_usb0_reg: usbreggrp { /*USB OverCurrent IOMUX Pin Configuration */
+		fsl,pins = <
+			MX8MP_IOMUXC_GPIO1_IO13__GPIO1_IO13      	0x154
+		>;
+	};
+	pinctrl_unused_gpio: unused_gpiogrp { /* GPIO: Unused GPIOs IOMUX Pin Configuration */
+                fsl,pins = <
+			MX8MP_IOMUXC_GPIO1_IO00__GPIO1_IO00             0x1c4 /* OSM LGA J5A Pin K19, Expansion U20 Pin 4 */
+			MX8MP_IOMUXC_GPIO1_IO03__GPIO1_IO03             0x1c4 /* OSM LGA U16 Pin B1 */
+			MX8MP_IOMUXC_GPIO1_IO06__GPIO1_IO06		0x1c4 /* OSM LGA J5A Pin J19, Expansion U7 Pin 8 */
+			MX8MP_IOMUXC_NAND_DQS__GPIO3_IO14               0x1c4 /* OSM LGA J5A Pin H19, Expansion U11 Pin 6 */
+			MX8MP_IOMUXC_SAI5_RXFS__GPIO3_IO19              0x1c4 /* OSM LGA J5A Pin F19, Expansion U11 Pin 2 */
+			MX8MP_IOMUXC_SAI5_RXC__GPIO3_IO20		0x1c4 /* OSM LGA J5A Pin J17, Expansion U3 Pin 7 */
+			MX8MP_IOMUXC_SAI1_MCLK__GPIO4_IO20              0x1c4 /* OSM LGA J5B Pin E3, Expansion U53 Pin 4 */
+                >;
+        };
+
+	pinctrl_expansion_gpio: expansion_gpiogrp {
+		fsl,pins = <
+			MX8MP_IOMUXC_NAND_DATA02__GPIO3_IO08		0x1c4 /* OSM LGA J5D Pin AN14, Expansion connector J6 Pin 35 */
+		>;
+	};
+};
+
+&unused_gpios { /* GPIO: iWave Unused GPIO pins */
+        gpios = <&gpio1 0 0>,
+		<&gpio1 3 0>,
+		<&gpio1 6 0>,
+		<&gpio3 14 0>,
+		<&gpio3 19 0>,
+		<&gpio3 20 0>,
+		<&gpio4 20 0>;
