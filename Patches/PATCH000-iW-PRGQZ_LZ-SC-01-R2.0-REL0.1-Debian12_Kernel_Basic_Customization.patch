+#include "imx8mp-iwg40d-prgwd.dts"
+
+&i2c3 {
+	/delete-node/ ov5640_mipi@3c;
+ 
+	basler_camera_vvcam@36 {
+		compatible = "basler,basler-camera-vvcam", "basler-camera-vvcam";
+		reg = <0x36>;
+		csi_id = <0x00>;
+		status = "okay";
+
+		port {
+			basler_ep_0: endpoint {
+				data-lanes = <1 2 3 4>;
+				clock-lanes = <0>;
+				link-frequencies = /bits/ 64 <750000000>;
+				max-lane-frequency = /bits/ 64 <750000000>;
+				max-pixel-frequency = /bits/ 64 <500000000>;
+				max-data-rate = /bits/ 64 <0>;
+				remote-endpoint = <&mipi_csi0_ep>;
+			};
+		};
+	};
+};
+
+&mipi_csi_0 {
+	status = "okay";
+
+	/delete-node/ port@0;
+	port@0 {
+		reg = <0>;
+		mipi_csi0_ep: endpoint {
+			remote-endpoint = <&basler_ep_0>;
+			data-lanes = <1 2 3 4>;
+			csis-hs-settle = <16>;
+		};
+	};
+};
+
+/*&mipi_csi_1 {
+	/delete-property/ #address-cells;
+	/delete-property/ #size-cells;
+	/delete-node/ port@1;
+};*/
+
+&cameradev {
+	status = "okay";
+};
+
+&isi_0 {
+	status = "disabled";
+
+	cap_device {
+		status = "disabled";
+	};
+};
+
+&isi_1 {
+	status = "disabled";
+};
+
+&isp_0 {
+	status = "okay";
+};
+
+&dewarp {
+	status = "okay";
+};
+
+&i2c3 {
+	/delete-node/ ov5640_mipi@3c;
+};
diff -Naur A/arch/arm64/boot/dts/freescale/imx8mp-iwg40d-prgwd-dpdk.dts B/arch/arm64/boot/dts/freescale/imx8mp-iwg40d-prgwd-dpdk.dts
--- A/arch/arm64/boot/dts/freescale/imx8mp-iwg40d-prgwd-dpdk.dts	1970-01-01 05:30:00.000000000 +0530
