+#ifdef CONFIG_IWG40M
+
+static void __init som_revision(int *pcb_rev, int *bom_rev, int *carrier_pcb, int *carrier_bom)
+{
+	struct device_node *np;
+	int prop=0;
+
+	np = of_find_node_by_name(NULL, "iwg40m_common");
+	if (!np) {
+		pr_warn("Failed to find som_revision node\n");
+		goto put_node;
+	}
+
+	prop |= of_property_read_u32(np, "pcb_rev", pcb_rev);
+	prop |= of_property_read_u32(np, "bom_rev", bom_rev);
+	prop |= of_property_read_u32(np, "carrier_pcb", carrier_pcb);
+	prop |= of_property_read_u32(np, "carrier_bom", carrier_bom);
+
+	if(!prop)
+		return;
+	else
+		pr_warn("failed to get board info\n");
+
+put_node:
+	*pcb_rev=0;
+	*bom_rev=0;
+	*carrier_pcb=0;
+	*carrier_bom=0;
+	of_node_put(np);
+	return;
+}
+
+void print_board_info (void)
+{
+	static int pcb_rev, bom_rev, carrier_pcb, carrier_bom;
+	som_revision(&pcb_rev, &bom_rev, &carrier_pcb, &carrier_bom);
+
+	pr_info ("\n");
+	pr_info ("Board Info:\n");
+
+	if (of_machine_is_compatible("fsl,imx8mp-iwg40m"))
+	{
+		pr_info ("\tBSP Version            : iW-PRGQZ-SC-01-R2.0-REL1.0-Linux6.6.3 Debian 12\n");
+		pr_info ("\tSOM Version            : iW-PRGQZ-AP-01-R%x.%x\n", pcb_rev, bom_rev);
+
+		if (carrier_pcb < 0 && carrier_bom < 0)
+			pr_info ("\tCarrier Board Version  : iW-PRGWD-AP-01-R2.X(Custom)\n");
+		else
+			pr_info ("\tCarrier Board Version  : iW-PRGWD-AP-01-R%x.%x\n", carrier_pcb, carrier_bom);
+        }
+	else if (of_machine_is_compatible("fsl,imx8mp-iwg40m-osm"))
+	{
+		pr_info ("\tBSP Version            : iW-PRGLZ-SC-01-R2.0-REL1.0-Linux6.6.3 Debian 12\n");
+		pr_info ("\tSOM Version            : iW-PRGLZ-AP-01-R%x.%x\n", pcb_rev, bom_rev);
+
+		if (carrier_pcb < 0 && carrier_bom < 0)
+			pr_info ("\tCarrier Board Version  : iW-PRGLZ-AP-01-R2.X(Custom)\n");
+		else
+			pr_info ("\tCarrier Board Version  : iW-PRGJJ-AP-01-R%x.%x\n", carrier_pcb, carrier_bom);
+
+	}
+	pr_info ("\tCPU Unique ID          : 0x%016llX\n",soc_uid);
+	pr_info ("\n");
+}
+#endif
