+		};
+	};
+};
+
+&ldb_phy {
+	status = "okay";
+};
+
+&pwm2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_pwm2>;
+	status = "okay";
+};
+
+&mipi_dsi {
+	status = "okay";
+	fsl,clock-drop-level = <2>;
+
+	mipidisp: panel@0 { /* MIPI_DSI: MIPI DSI Host */
+		compatible = "raydium,rm67198";
+		reg = <0>;
+		pinctrl-names = "default";
+		v3p3-supply = <&reg_3p3v>;
+		v1p8-supply = <&reg_1p8v>;
+		dsi-lanes = <4>;
+		video-mode = <1>;
+		width-mm = <68>;
+		height-mm = <121>;
+		status = "okay";
+	};
+};
+
+&iomuxc {
+	pinctrl_pwm2: pwm2grp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SAI5_RXD0__PWM2_OUT      0xd6
+		>;
+	};
+
+	pinctrl_lvds1: lvds_grp {
+		fsl,pins = <
+			MX8MP_IOMUXC_NAND_DATA01__GPIO3_IO07   0x1c4
+		>;
+	};
+
+	pinctrl_ts_active_iwg40m: touch { /* Touch: IOMUX Pin Configuration */
+		fsl,pins = <
+			MX8MP_IOMUXC_SAI1_RXFS__GPIO4_IO00      0x1c4 /* Touch IRQ GPIO */
+			MX8MP_IOMUXC_SAI1_TXD7__GPIO4_IO19     0x1c4 /* Touch Reset GPIO */
+		>;
+	};
+};
