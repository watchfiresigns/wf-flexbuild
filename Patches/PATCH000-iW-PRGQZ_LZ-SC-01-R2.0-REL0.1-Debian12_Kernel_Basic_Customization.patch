diff -Naur A/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm-gnss.dts B/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm-gnss.dts
--- A/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm-gnss.dts	1970-01-01 05:30:00.000000000 +0530
+++ B/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm-gnss.dts	2024-12-02 12:42:51.291154266 +0530
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (C) 2024 iWave Systems Technologies Pvt Ltd.
+ */
+
+#include "imx8mp-iwg40s-prgjj.dts"
+
+&uart3 {
+	assigned-clocks = <&clk IMX8MP_CLK_UART3>;
+	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
+	status = "okay";
+
+	gnss {
+		compatible = "u-blox,neo-m8";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_uart3>;
+		vcc-supply = <&reg_3p3v>;
+		reset-gpios = <&gpio4 2 GPIO_ACTIVE_LOW>;
+		status = "okay";
+		current-speed = <9600>;
+	};
+};
+
+&iomuxc {
+	pinctrl_uart3: uart3grp { /*UART3: GNSS IOMUX Pin Configuration*/
+		fsl,pins = <
+			MX8MP_IOMUXC_NAND_CE0_B__UART3_DCE_TX	0x40
+			MX8MP_IOMUXC_NAND_ALE__UART3_DCE_RX	0x40
+			MX8MP_IOMUXC_SAI1_RXD0__GPIO4_IO02	0x140 /* GNSS Reset GPIO */
+		>;
+	};
+};
diff -Naur A/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm-rpmsg.dts B/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm-rpmsg.dts
--- A/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm-rpmsg.dts	1970-01-01 05:30:00.000000000 +0530
+++ B/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm-rpmsg.dts	2024-12-02 12:42:51.291154266 +0530
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright 2020 NXP
+ */
+
+/dts-v1/;
+
+#include "imx8mp-iwg40s-prgjj.dts"
+
+/ {
+	aliases {
+		i2c0 = &i2c1;
+		i2c1 = &i2c2;
+		i2c2 = &i2c_rpbus_3;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		m4_reserved: m4@80000000 {
+			no-map;
+			reg = <0 0x80000000 0 0x1000000>;
+		};
+
+		vdev0vring0: vdev0vring0@55000000 {
+			reg = <0 0x55000000 0 0x8000>;
+			no-map;
+		};
+
+		vdev0vring1: vdev0vring1@55008000 {
+			reg = <0 0x55008000 0 0x8000>;
+			no-map;
+		};
+
+		vdevbuffer: vdevbuffer@55400000 {
+			compatible = "shared-dma-pool";
+			reg = <0 0x55400000 0 0x100000>;
+			no-map;
+		};
+
+		rsc_table: rsc-table@550ff000 {
+			reg = <0 0x550ff000 0 0x1000>;
+			no-map;
+		};
+	};
+
+	imx8mp-cm7 {
+		compatible = "fsl,imx8mn-cm7";
+		rsc-da = <0x55000000>;
+		clocks = <&clk IMX8MP_CLK_M7_DIV>,
+			 <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_AUDPLL_ROOT>;
+		clock-names = "core", "audio";
+		mbox-names = "tx", "rx", "rxdb";
+		mboxes = <&mu 0 1
+			  &mu 1 1
+			  &mu 3 1>;
+		memory-region = <&vdevbuffer>, <&vdev0vring0>, <&vdev0vring1>, <&rsc_table>;
+		status = "okay";
+		fsl,startup-delay-ms = <500>;
+	};
+};
+
+&ecspi2 {
+	status = "disabled";
+};
+
+&flexcan1 {
+	status = "disabled";
+};
+
+&flexspi {
+	status = "disabled";
+};
+
+/delete-node/ &i2c3;
+
+&i2c_rpbus_3 {
+	compatible = "fsl,i2c-rpbus";
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	ov5640_0: ov5640_mipi@3c {
+                compatible = "ovti,ov5640";
+                reg = <0x3c>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&pinctrl_csi0_rst>,<&pinctrl_csi_mclk>;
+                clocks = <&clk IMX8MP_CLK_IPP_DO_CLKO1>;
+                clock-names = "xclk";
+                assigned-clocks = <&clk IMX8MP_CLK_IPP_DO_CLKO1>;
+                assigned-clock-parents = <&clk IMX8MP_CLK_24M>;
+                assigned-clock-rates = <24000000>;
+                csi_id = <0>;
+                reset-gpios = <&gpio4 0 GPIO_ACTIVE_LOW>;
+                mclk = <24000000>;
+                mclk_source = <0>;
+                mipi_csi;
+                status = "okay";
+
+                port {
+                        ov5640_mipi_0_ep: endpoint {
+                                remote-endpoint = <&mipi_csi0_ep>;
+                                data-lanes = <1 2>;
+                                clock-lanes = <0>;
+                        };
+                };
+        };
+};
+
+&sai3 {
+	status = "disabled";
+};
+
+&sdma3{
+	status = "disabled";
+};
+
+
+&uart2 {
+	status = "disabled";
+};
