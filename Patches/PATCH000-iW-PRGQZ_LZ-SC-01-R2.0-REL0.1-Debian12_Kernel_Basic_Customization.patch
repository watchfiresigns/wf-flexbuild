diff -Naur A/arch/arm64/boot/dts/freescale/imx8mp-iwg40d-prgwd-powertip-wxga-lvdsCH1.dts B/arch/arm64/boot/dts/freescale/imx8mp-iwg40d-prgwd-powertip-wxga-lvdsCH1.dts
