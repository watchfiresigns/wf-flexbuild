+	status = "disabled";
+};
+
+&hdmiphy {
+	status = "disabled";
+};
+
+&lcdif3 { /*HDMI Display controller*/
+	status = "disabled";
+};
+
+&mipi_dsi {
+	status = "okay";
+	fsl,clock-drop-level = <2>;
+
+	mipidisp:panel@0 { /* MIPI_DSI: MIPI DSI Host */
+                compatible = "panel-rcl";
+                reg = <0>;
+                dsi-lanes = <4>;
+                video-mode = <2>;       /* 0: burst mode
+                                         * 1: non-burst mode with sync event
+                                         * 2: non-burst mode with sync pulse
+                                         */
+                width-mm = <154>;
+                height-mm = <85>;
+                status = "okay";
+        };
