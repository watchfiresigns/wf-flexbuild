+                compatible = "focaltech,fts";
+                reg = <0x38>;
+                interrupt-parent = <&gpio4>;
+                interrupts = <0 GPIO_ACTIVE_LOW>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&pinctrl_ts_active_iwg40m>;
+                status = "okay";
+		irq-gpio = <&gpio4 0 GPIO_ACTIVE_LOW>;
