diff -Naur A/drivers/gpio/gpio-unused.c B/drivers/gpio/gpio-unused.c
--- A/drivers/gpio/gpio-unused.c	1970-01-01 05:30:00.000000000 +0530
+++ B/drivers/gpio/gpio-unused.c	2024-12-02 12:42:51.296154356 +0530
@@ -0,0 +1,120 @@
