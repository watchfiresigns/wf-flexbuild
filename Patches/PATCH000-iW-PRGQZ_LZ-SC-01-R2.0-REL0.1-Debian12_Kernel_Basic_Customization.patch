+
+};
+
+&irqsteer_hdmi {
+        status = "disabled";
+};
+
+&hdmi_blk_ctrl {
+        status = "disabled";
+};
+
+&hdmi_pavi {
+        status = "disabled";
+};
+
+&hdmi {
+        status = "disabled";
+};
+
+&hdmiphy {
+        status = "disabled";
+};
+
+&lcdif3 { /*LVDS Display controller*/
+        status = "disabled";
+};
+
+
+&lcdif2 { /*LVDS Display controller*/
+	status = "okay";
+};
+
+&ldb {
+	status = "okay";
+
+	lvds-channel@1 {
+		fsl,data-mapping = "spwg";
+		fsl,data-width = <24>;
+		#address-cells = <1>;
+                #size-cells = <0>;
+		status = "okay";
+
+		port@1 {
+			reg = <1>;
+			lvds1_out: endpoint {
+				remote-endpoint = <&panel_lvds1_in>;
+			};
