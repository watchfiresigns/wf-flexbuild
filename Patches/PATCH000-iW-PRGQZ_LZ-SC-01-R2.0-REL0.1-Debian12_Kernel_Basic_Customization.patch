+		power-supply = <&reg_3p3v>;
+		enable-gpios = <&gpio3 14 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+
+		port {
+			panel_lvds1_in: endpoint {
+				remote-endpoint = <&lvds1_out>;
+			};
+		};
+	};
+
+	lvds1_backlight: lvds1_backlight { /* LVDS1: LVDS Backlight Enable */
