diff -Naur A/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-gnss.dts B/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-gnss.dts
--- A/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-gnss.dts	1970-01-01 05:30:00.000000000 +0530
+++ B/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-gnss.dts	2024-12-02 12:42:51.290154248 +0530
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (C) 2024 iWave System Technologies Pvt Ltd.
+ */
+
+#include "imx8mp-iwg40d-prgwd.dts"
+
+&uart3 { /* GNSS */
+	assigned-clocks = <&clk IMX8MP_CLK_UART3>;
+	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
+	status = "okay";
+
+	gnss {
+		compatible = "u-blox,neo-m8";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_uart3>;
+		vcc-supply = <&reg_3p3v>;
+		reset-gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
+		status = "okay";
+		current-speed = <9600>;
+	};
+};
+
+&iomuxc {
+	pinctrl_uart3: uart3grp { /*UART3: GNSS IOMUX Pin Configuration*/
+		fsl,pins = <
+			MX8MP_IOMUXC_NAND_CE0_B__UART3_DCE_TX	0x40
+			MX8MP_IOMUXC_NAND_ALE__UART3_DCE_RX	0x40
+			MX8MP_IOMUXC_GPIO1_IO05__GPIO1_IO05	0x1c4 /* GNSS Reset GPIO */
+		>;
+	};
+};
diff -Naur A/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm.dtsi B/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm.dtsi
--- A/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm.dtsi	1970-01-01 05:30:00.000000000 +0530
+++ B/arch/arm64/boot/dts/freescale/imx8mp-iwg40m-osm.dtsi	2024-12-09 11:16:15.660586572 +0530
@@ -0,0 +1,866 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (C) 2024 iWave Systems Technologies Pvt Ltd.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/phy/phy-imx8-pcie.h>
+#include <dt-bindings/usb/pd.h>
+#include "imx8mp.dtsi"
+
+/ {
+	chosen {
+		stdout-path = &uart4;
+	};
+
+	aliases {
+		mmc0 = &usdhc3;
+		mmc1 = &usdhc2;
+		mmc2 = &usdhc1;
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0 0xc0000000>,
+		      <0x1 0x00000000 0 0x40000000>;
+	};
+
+	reg_pcie0: regulator-pcie {
+		compatible = "regulator-fixed";
+		regulator-name = "MPCIE_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	vcc5v0_usb0: vcc5v0-usb0-regulator { /* Regulator: Fixed 5V Regulator */
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_usb0";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+
+	reg_usdhc2_vmmc: regulator-usdhc2 { /* USDHC2: 3.3V VDD Enable Regulator */
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
+		regulator-name = "VSD_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio2 19 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
