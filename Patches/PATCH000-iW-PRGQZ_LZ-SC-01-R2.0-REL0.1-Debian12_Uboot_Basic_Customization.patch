+#define PCF8574_I2C_DEV         0
+#define PCF8574_I2C_ADDR        0x39
+
+int get_carrier_revision(int *probe, int *carrier_pcb, int *carrier_bom)
+{
+       struct udevice *bus;
+       struct udevice *i2c_dev = NULL;
+       int bus_seq, revision;
+
+       bus_seq = uclass_get_device_by_seq(UCLASS_I2C, PCF8574_I2C_DEV, &bus);
+
+       if (bus_seq) {
+               printf("%s: Can't find bus\n", __func__);
+               return -EINVAL;
+       }
+
+       *probe = dm_i2c_probe(bus, PCF8574_I2C_ADDR, 0 , &i2c_dev);
+       if (*probe) {
+               debug("Can't find device id=0x%x\n", *probe);
+               return *probe;
+       }
+
+       else
+       {
+               revision = dm_i2c_reg_read(i2c_dev, 0xff);
+               *carrier_pcb = (revision & 0x07)+1;
+               *carrier_bom = ((revision & 0xF8)>>3);
+               return 0;
+       }
+
+       return -ENODEV;
+}
