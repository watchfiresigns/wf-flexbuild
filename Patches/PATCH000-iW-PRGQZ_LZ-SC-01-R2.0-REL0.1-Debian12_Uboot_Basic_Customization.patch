+	/* IWG40M: Updating SOM revision to device tree */
+	get_board_info(&pcb_rev, &bom_rev);
+	get_carrier_revision(&pcf8574_reg, &carrier_pcb, &carrier_bom);
+	ret |= fdt_setprop_u32(blob,fdt_path_offset(blob, "/iwg40m_common"), "pcb_rev", pcb_rev);
+        ret |= fdt_setprop_u32(blob,fdt_path_offset(blob, "/iwg40m_common"), "bom_rev", bom_rev);
+        ret |= fdt_setprop_u32(blob,fdt_path_offset(blob, "/iwg40m_common"), "carrier_pcb", carrier_pcb);
+        ret |= fdt_setprop_u32(blob,fdt_path_offset(blob, "/iwg40m_common"), "carrier_bom", carrier_bom);
+
+	if(ret){
+                printf("Failed to pass SOM revision to kernel FTD file\n");
+        }
+
+        if ( pcb_rev == 2 && bom_rev == 4) {
+                /* Disable WiFi, BT, FEC and EQOS ethernet */
+                ret = fdt_setprop_string(blob, fdt_path_offset(blob, "/soc@0/bus@30800000/mmc@30b40000/"), "status", "disabled");
+                ret |= fdt_setprop_string(blob, fdt_path_offset(blob, "/soc@0/bus@30800000/mmc@30b40000/bcrmf@1/"), "status", "disabled");
+                ret |= fdt_setprop_string(blob, fdt_path_offset(blob, "/soc@0/bus@30800000/serial@30860000/"), "status", "disabled");
+                ret |= fdt_setprop_string(blob, fdt_path_offset(blob, "/soc@0/bus@30800000/ethernet@30be0000/"), "status", "disabled");
+                ret |= fdt_setprop_string(blob, fdt_path_offset(blob, "/soc@0/bus@30800000/ethernet@30bf0000/"), "status", "disabled");
+                ret |= fdt_del_node(blob, fdt_path_offset(blob, "/modem-reset/"));
+                ret |= fdt_del_node(blob, fdt_path_offset(blob, "/usdhc1_pwrseq/"));
+                if (ret)
+                	printf("Failed to disable nodes in kernel FTD file\n");
+        }
+
+	if (!strcmp("enabled", env_get("usb3.0_top"))){
+		fdt_setprop_string(blob, fdt_path_offset(blob, "/soc@0/usb@32f10100/usb@38100000/"), "dr_mode", "host");
+		fdt_setprop_string(blob, fdt_path_offset(blob, "/vcc5v0-typec-regulator"), "regulator-boot-on", NULL);
+		fdt_setprop_string(blob, fdt_path_offset(blob, "/vcc5v0-typec-regulator"), "regulator-always-on", NULL);
+		fdt_delprop(blob, fdt_path_offset(blob, "/soc@0/usb@32f10100/usb@38100000"), "hnp-disable");
+		fdt_delprop(blob, fdt_path_offset(blob, "/soc@0/usb@32f10100/usb@38100000"), "srp-disable");
+		fdt_delprop(blob, fdt_path_offset(blob, "/soc@0/usb@32f10100/usb@38100000"), "adp-disable");
+		fdt_delprop(blob, fdt_path_offset(blob, "/soc@0/usb@32f10100/usb@38100000"), "usb-role-switch");
+        }
+	return 0;
