+#ifdef CONFIG_OF_BOARD_SETUP
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	int ret=0;
+	static int pcb_rev, bom_rev, carrier_pcb, carrier_bom, pcf8574_reg;
+
+#ifdef CONFIG_SDRAM_SIZE_2GB
+	static uint32_t reg[2],reg1[4],gpu[4];
