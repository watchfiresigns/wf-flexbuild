+/* backlight control */
+#define LVDS_BKLT_GPIO IMX_GPIO_NR(3,21)
+#define LVDS_BKLT_EN_GPIO IMX_GPIO_NR(3,14)
+static iomux_v3_cfg_t lvds_bklt_pads[] = {
+        MX8MP_PAD_SAI5_RXD0__GPIO3_IO21 | MUX_PAD_CTRL(NO_PAD_CTRL),
+	MX8MP_PAD_NAND_DQS__GPIO3_IO14 | MUX_PAD_CTRL(NO_PAD_CTRL),
+};
+
+void lvds_bklt_enable(void)
+{
+       imx_iomux_v3_setup_multiple_pads(lvds_bklt_pads, ARRAY_SIZE(lvds_bklt_pads));
+        gpio_request(LVDS_BKLT_GPIO, "lvds_bklt");
+        gpio_direction_output(LVDS_BKLT_GPIO, 1);
+
+        gpio_request(LVDS_BKLT_EN_GPIO, "lvds_bklt_en");
+        gpio_direction_output(LVDS_BKLT_EN_GPIO, 1);
+
+        gpio_free(LVDS_BKLT_GPIO);
+	gpio_free(LVDS_BKLT_EN_GPIO);
+}
