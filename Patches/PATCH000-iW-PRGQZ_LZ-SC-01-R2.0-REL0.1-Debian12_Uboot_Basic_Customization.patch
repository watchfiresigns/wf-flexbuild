+	reg[1] = cpu_to_fdt32(0x14000000);
+	ret= fdt_setprop(blob,fdt_path_offset(blob, "/reserved-memory/linux,cma"), "size", reg, sizeof(reg));
+	if(ret<0){
+		printf("Kernel FTD CMA memory range update is failed\n");
