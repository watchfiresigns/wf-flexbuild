+static iomux_v3_cfg_t wifi_pads[] = {
+       MX8MP_PAD_SD1_DATA4__GPIO2_IO06 | MUX_PAD_CTRL(GPIO_PAD_CTRL),
+       MX8MP_PAD_SD1_DATA5__GPIO2_IO07 | MUX_PAD_CTRL(GPIO_PAD_CTRL),
+};
