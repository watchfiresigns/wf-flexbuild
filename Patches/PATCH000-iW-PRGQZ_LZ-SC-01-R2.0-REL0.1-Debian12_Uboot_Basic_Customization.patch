+	rpmsg[2] = cpu_to_fdt32(0x00000000);
+	rpmsg[3] = cpu_to_fdt32(0x1000000);
+	ret= fdt_setprop(blob,fdt_path_offset(blob, "/reserved-memory/m4@80000000"), "reg", rpmsg, sizeof(rpmsg));
+	if(ret<0){
