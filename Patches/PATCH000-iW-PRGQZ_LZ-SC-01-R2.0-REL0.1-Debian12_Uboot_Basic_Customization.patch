+static iomux_v3_cfg_t const board_cfg[] = {
+        MX8MP_PAD_SD1_DATA6__GPIO2_IO08 | MUX_PAD_CTRL(NO_PAD_CTRL),
+	MX8MP_PAD_SD1_DATA7__GPIO2_IO09 | MUX_PAD_CTRL(NO_PAD_CTRL),
+	MX8MP_PAD_SD1_STROBE__GPIO2_IO11| MUX_PAD_CTRL(NO_PAD_CTRL),
+	MX8MP_PAD_SD1_RESET_B__GPIO2_IO10 | MUX_PAD_CTRL(NO_PAD_CTRL),
+	MX8MP_PAD_GPIO1_IO01__GPIO1_IO01 | MUX_PAD_CTRL(NO_PAD_CTRL),
+};
+
+#define PCF8574_I2C_DEV         1
+#define PCF8574_I2C_ADDR        0x39
+
+int get_carrier_revision(int *probe, int *carrier_pcb, int *carrier_bom)
+{
+       struct udevice *bus;
+       struct udevice *i2c_dev = NULL;
+       int bus_seq, revision;
+
+       bus_seq = uclass_get_device_by_seq(UCLASS_I2C, PCF8574_I2C_DEV, &bus);
+
+       if (bus_seq) {
+               printf("%s: Can't find bus\n", __func__);
+               return -EINVAL;
+       }
+
+       *probe = dm_i2c_probe(bus, PCF8574_I2C_ADDR, 0 , &i2c_dev);
+       if (*probe) {
+               debug("Can't find device id=0x%x\n", *probe);
+               return *probe;
+       }
+
+       else
+       {
+               revision = dm_i2c_reg_read(i2c_dev, 0xff);
+               *carrier_pcb = (revision & 0x07)+1;
+               *carrier_bom = ((revision & 0xF8)>>3);
+               return 0;
+       }
+
+       return -ENODEV;
+}
+
+
+int get_board_info(int *pcb_rev, int *bom_rev)
+{
+        int i;
+
+        imx_iomux_v3_setup_multiple_pads(board_cfg,
+                                         ARRAY_SIZE(board_cfg));
+
+	for (i=0;i<ARRAY_SIZE(board_config_pads);i++) {
+		if(i<2) {
+			gpio_request(board_config_pads[i], "PCB-Revision-GPIO");
+			gpio_direction_input(board_config_pads[i]);
+			*pcb_rev |= (gpio_get_value(board_config_pads[i]) << i);
+		} else {
+			gpio_request(board_config_pads[i], "BOM-Revision-GPIO");
+			gpio_direction_input(board_config_pads[i]);
+			*bom_rev |= (gpio_get_value(board_config_pads[i]) << (i-2));
+                }
+        }
+	*pcb_rev +=1;
+	return 0;
+}
+
+static void print_board_info(void)
+{
+    struct tag_serialnr serialnr;
+    static int pcb_rev, bom_rev, carrier_pcb, carrier_bom, pcf8574_reg;
+
+    /*IWG40M : Adding CPU Unique ID read support*/
+    get_board_serial(&serialnr);
+
+    /*IWG40M : Adding SOM Configuration number read support*/
+    get_board_info(&pcb_rev, &bom_rev);
+
+    /*IWG40M : Adding Carrier board Configuration read support*/ 
+    get_carrier_revision(&pcf8574_reg, &carrier_pcb, &carrier_bom);
+    
+    printf ("Board Info:\n");
+    printf ("\tBSP Version               : %s\n", BSP_VERSION);
+    printf ("\tSOM Version               : iW-PRGQZ-AP-01-R%x.%x\n",pcb_rev,bom_rev);
+    printf ("\tCPU Unique ID             : 0x%08X%08X\n",serialnr.high,serialnr.low);
+
+    if(pcf8574_reg == 0)
+    	printf ("\tCarrier Board Version     : iW-PRGWD-AP-01-R%x.%x\n", carrier_pcb, carrier_bom);
+    else
+    	printf ("\tCarrier Board Version     : iW-PRGWD-AP-01-RX.X(Custom)\n");
+    printf ("\n");
+}
